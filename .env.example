# 复制为 .env 后填写。数据库密码建议使用随机十六进制字符。
POSTGRES_ADMIN_PASSWORD=replace-with-random-hex
DB_PASSWORD=replace-with-different-random-hex
SECRET_KEY=replace-with-random-hex-at-least-32-bytes
# 哈希含 $，请用单引号包裹；不要填写明文密码。
ADMIN_PASSWORD_HASH='replace-with-werkzeug-password-hash'
WEB_BIND_IP=127.0.0.1
WEB_PORT=8088
COOKIE_SECURE=0
